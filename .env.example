# Postgres
POSTGRES_USER=visitly
POSTGRES_PASSWORD=visitly_dev_change_me
POSTGRES_DB=visitly
DATABASE_URL=postgresql+psycopg://visitly:visitly_dev_change_me@localhost:5433/visitly

# Mirror profile: global | iran
VISITLY_MIRROR_PROFILE=global

# Images / registries (global defaults — override for Iran)
POSTGRES_IMAGE=postgres:16-alpine
NODE_IMAGE=node:22-alpine
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=pypi.org
NPM_REGISTRY=https://registry.npmjs.org

# Iran example:
# VISITLY_MIRROR_PROFILE=iran
# POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
# NODE_IMAGE=docker.arvancloud.ir/library/node:22-alpine
# PYTHON_IMAGE=docker.arvancloud.ir/library/python:3.12-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com

# Site
VISITLY_SITE_NAME=My Site
VISITLY_SITE_HOSTS=example.com,www.example.com
VISITLY_TIMEZONE=UTC
VISITLY_BASE_PATH=/stats
VISITLY_LOCALE=en

# Auth
VISITLY_ADMIN_USER=admin
VISITLY_ADMIN_PASSWORD=change-me
VISITLY_SESSION_SECRET=change-me-to-a-long-random-string
VISITLY_COOKIE_NAME=visitly_sess
VISITLY_SESSION_TTL_SECONDS=604800

# API
VISITLY_HOST=127.0.0.1
VISITLY_PORT=3099
VISITLY_CORS_ORIGINS=http://localhost:5173

# Collector: file | docker
VISITLY_LOG_SOURCE=file
VISITLY_LOG_PATH=/var/log/nginx/access.log
VISITLY_HOST_LOG_DIR=/var/log/nginx
VISITLY_DOCKER_CONTAINER=nginx
# Use a host-mounted path in production (Compose mounts /var/lib/visitly).
# ./collect.lock is fine only for local one-off runs — ephemeral compose run
# containers cannot share that file across cron ticks.
VISITLY_LOCK_PATH=/var/lib/visitly/collect.lock
VISITLY_LOCK_DIR=/var/lib/visitly
VISITLY_HUMAN_DAY_CAP=120
