# Postgres
POSTGRES_USER=visitly
POSTGRES_PASSWORD=visitly_dev_change_me
POSTGRES_DB=visitly
DATABASE_URL=postgresql+psycopg://visitly:visitly_dev_change_me@localhost:5432/visitly

# Site
VISITLY_SITE_NAME=My Site
VISITLY_SITE_HOSTS=example.com,www.example.com
VISITLY_TIMEZONE=UTC
VISITLY_BASE_PATH=/stats
VISITLY_LOCALE=en

# Auth
VISITLY_ADMIN_USER=admin
VISITLY_ADMIN_PASSWORD=change-me
VISITLY_SESSION_SECRET=change-me-to-a-long-random-string
VISITLY_COOKIE_NAME=visitly_sess
VISITLY_SESSION_TTL_SECONDS=604800

# API
VISITLY_HOST=127.0.0.1
VISITLY_PORT=3099
VISITLY_CORS_ORIGINS=http://localhost:5173

# Collector: file | docker
VISITLY_LOG_SOURCE=file
VISITLY_LOG_PATH=/var/log/nginx/access.log
VISITLY_DOCKER_CONTAINER=nginx
VISITLY_LOCK_PATH=./collect.lock
VISITLY_HUMAN_DAY_CAP=120
